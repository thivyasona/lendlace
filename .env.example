# Copy to .env (never commit .env!) and fill in real values.
# The app reads these from the environment (DBConnection.java, EmailUtil.java).

# --- MySQL database ---
DB_URL=jdbc:mysql://localhost:3306/lend_lace
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# --- SMTP (for password-reset + booking emails) ---
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=you@gmail.com
MAIL_SMTP_PASS=your_app_password   # use a Gmail "App Password", NOT your real password
MAIL_FROM=you@gmail.com

# --- Optional: dev-only credential reset tool (UpdateCredentials.java) ---
# Format: email:password,email2:password2
# CRED_UPDATE_ACCOUNTS=admin@example.com:ChangeMe1,owner@example.com:ChangeMe2
